!.vscode/extensions.json

# Claude Code: config personal (la compartida es .claude/settings.json)
.claude/settings.local.json

# zips originales de fotos (ya extraídas en assets/)
*.zip

# videos originales (se commitean solo las versiones optimizadas de public/video/)
assets/videos/

# banners: originales tal como los mandó Mar (en assets/banners/ van los renombrados/recortados)
assets/banners/originales/

# marca: originales (ilustración de mini Mar con fondo, antes del recorte)
assets/marca/originales/

# reseñas: fotos originales de las clientas (en assets/resenas/ van los recortes cuadrados)
assets/resenas/originales/

# fotos del estudio: originales en resolución completa (en assets/estudio/ van las optimizadas)
assets/estudio/originales/

# productos: originales tal como los mandó Mar (en assets/productos/ van las copias renombradas)
assets/productos/originales/

# envíos: tabla de tarifas de MC Mensajería que mandó Mar (los precios están en src/config/envios.js)
assets/envios/originales/

# respaldos de la base antes de cargas grandes (filas completas de Supabase, solo locales)
assets/respaldos/
